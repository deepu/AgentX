{
  "name": "@memwise/server",
  "version": "0.15.3",
  "description": "Standalone headless MemWise server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "memwise-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "MemWise contributors"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/deepu/AgentX",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@memwise/core": "workspace:*",
    "@memwise/messaging-gateway": "workspace:*",
    "@memwise/server-core": "workspace:*",
    "@memwise/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
