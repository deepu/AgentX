{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entity": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "description": "A value type: Text, Money, Identifier(GSTIN), Quantity(kg), Enum[a, b], List<T>, Ref<Entity>, or a record type name."
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "A value type: Text, Money, Identifier(GSTIN), Quantity(kg), Enum[a, b], List<T>, Ref<Entity>, or a record type name."
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "access": {
                "description": "Roles allowed to see the field.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "relationships": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\s*(one|many)\\s+[A-Za-z_]\\w*\\s*$"
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ownership": {
      "description": "field → owner (a plugin id or domain).",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "entity",
    "fields"
  ],
  "additionalProperties": false,
  "title": "MemWise entity type",
  "description": "domain/entities/<name>.yaml."
}
