{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "description": "Default: the file name.",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "startAt": {
      "type": "string"
    },
    "case": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "model": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "toolCalls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "args": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "name",
                  "args"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "approvals": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "approve",
          "reject"
        ]
      }
    },
    "submit": {
      "description": "Answers to person and external steps, by state: one for every visit, or a list used in order.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string"
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "outcome"
            ],
            "additionalProperties": false
          },
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "outcome": {
                  "type": "string"
                },
                "values": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "comment": {
                  "type": "string"
                }
              },
              "required": [
                "outcome"
              ],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    "expect": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "writes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "effects": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "entities": {
          "description": "Rows in the domain tables after the run, by entity type: a count, or the rows (matched on the listed fields).",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "case",
    "expect"
  ],
  "additionalProperties": false,
  "title": "MemWise example case",
  "description": "workflows/<id>/examples/*.yaml."
}
