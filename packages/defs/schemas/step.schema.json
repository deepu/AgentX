{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "performer": {
      "type": "string",
      "enum": [
        "agent",
        "person",
        "external",
        "system"
      ]
    },
    "strictness": {
      "description": "Default guided.",
      "type": "string",
      "enum": [
        "strict",
        "guided",
        "open"
      ]
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^case\\.[A-Za-z_][\\w.]*$"
      }
    },
    "writes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "description": "A value type: Text, Money, Identifier(GSTIN), Quantity(kg), Enum[a, b], List<T>, Ref<Entity>, or a record type name."
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "A value type: Text, Money, Identifier(GSTIN), Quantity(kg), Enum[a, b], List<T>, Ref<Entity>, or a record type name."
              },
              "from": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\s*(judgement|person|tool\\s+\\S+)\\s*$"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string"
                      },
                      "field": {
                        "description": "Dotted path inside the tool result.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "tool"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "model": {
      "description": "A model role, never a model name.",
      "type": "string"
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*[kKmM]?\\s*$"
            }
          ],
          "description": "A count: 12, 40k, 1.5m (million)."
        },
        "time": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*(ms|s|m|h|d|w)\\s*)+$|^\\s*\\d+\\s*$"
            }
          ],
          "description": "A duration: 30s, 10m, 3d, 1h30m, or a number of milliseconds."
        },
        "modelCalls": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*[kKmM]?\\s*$"
            }
          ],
          "description": "A count: 12, 40k, 1.5m (million)."
        }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy": {
          "description": "The layer name.",
          "type": "string"
        },
        "effects": {
          "type": "object",
          "properties": {
            "read": {
              "type": "string",
              "enum": [
                "allow",
                "preview",
                "approve",
                "deny"
              ]
            },
            "draft": {
              "type": "string",
              "enum": [
                "allow",
                "preview",
                "approve",
                "deny"
              ]
            },
            "write": {
              "type": "string",
              "enum": [
                "allow",
                "preview",
                "approve",
                "deny"
              ]
            },
            "outbound": {
              "type": "string",
              "enum": [
                "allow",
                "preview",
                "approve",
                "deny"
              ]
            },
            "irreversible": {
              "type": "string",
              "enum": [
                "allow",
                "preview",
                "approve",
                "deny"
              ]
            }
          },
          "additionalProperties": false
        },
        "tools": {
          "type": "object",
          "properties": {
            "allow": {
              "description": "If set, only these tools.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "require": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "treatment": {
                    "type": "string",
                    "enum": [
                      "allow",
                      "preview",
                      "approve",
                      "deny"
                    ]
                  },
                  "rateLimit": {
                    "type": "string",
                    "pattern": "^\\s*\\d+\\s*\\/\\s*(\\d+(\\.\\d+)?\\s*)?(ms|s|m|h|d|w|sec|second|min|minute|hr|hour|day|week)\\s*$"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "budgets": {
          "type": "object",
          "properties": {
            "tokens": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*\\d+(\\.\\d+)?\\s*[kKmM]?\\s*$"
                }
              ],
              "description": "A count: 12, 40k, 1.5m (million)."
            },
            "time": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*(ms|s|m|h|d|w)\\s*)+$|^\\s*\\d+\\s*$"
                }
              ],
              "description": "A duration: 30s, 10m, 3d, 1h30m, or a number of milliseconds."
            },
            "modelCalls": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\s*\\d+(\\.\\d+)?\\s*[kKmM]?\\s*$"
                }
              ],
              "description": "A count: 12, 40k, 1.5m (million)."
            },
            "money": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              },
              "required": [
                "amount",
                "currency"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "modelRoles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taint": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "outboundWhenTainted": {
              "type": "string",
              "enum": [
                "allow",
                "preview",
                "approve",
                "deny"
              ]
            }
          },
          "additionalProperties": false
        },
        "approvals": {
          "type": "object",
          "properties": {
            "by": {
              "description": "Roles that may decide effect approvals.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "title": "MemWise policy layer",
      "description": "domain/policy.yaml, workflows/<id>/policy.yaml, or the policy block of a step."
    },
    "assignee": {
      "description": "Role that does (or decides) a person or external step.",
      "type": "string"
    },
    "map": {
      "description": "System steps: arguments for each tool, in call order. `case.<field>` reads the case; anything else is a literal (or write { value: ... }).",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "title",
    "performer"
  ],
  "additionalProperties": false,
  "title": "MemWise step",
  "description": "The front matter of workflows/<id>/steps/<state>.md."
}
