{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "description": "A value type: Text, Money, Identifier(GSTIN), Quantity(kg), Enum[a, b], List<T>, Ref<Entity>, or a record type name."
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "A value type: Text, Money, Identifier(GSTIN), Quantity(kg), Enum[a, b], List<T>, Ref<Entity>, or a record type name."
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "access": {
                "description": "Roles allowed to see the field.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "controlled": {
                "description": "Phase 6: false exempts the field from the regulated reason rule (default true in a regulated domain).",
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "types": {
      "description": "Small record types used by fields.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string",
              "description": "A value type: Text, Money, Identifier(GSTIN), Quantity(kg), Enum[a, b], List<T>, Ref<Entity>, or a record type name."
