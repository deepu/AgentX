{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "policy": {
      "description": "The layer name.",
      "type": "string"
    },
    "effects": {
      "type": "object",
      "properties": {
        "read": {
          "type": "string",
          "enum": [
            "allow",
            "preview",
            "approve",
            "deny"
          ]
        },
        "draft": {
          "type": "string",
          "enum": [
            "allow",
            "preview",
            "approve",
            "deny"
          ]
        },
        "write": {
          "type": "string",
          "enum": [
            "allow",
            "preview",
            "approve",
            "deny"
          ]
        },
        "outbound": {
          "type": "string",
          "enum": [
            "allow",
            "preview",
            "approve",
            "deny"
          ]
        },
        "irreversible": {
          "type": "string",
          "enum": [
            "allow",
            "preview",
            "approve",
            "deny"
          ]
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "allow": {
          "description": "If set, only these tools.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "treatment": {
                "type": "string",
                "enum": [
                  "allow",
                  "preview",
                  "approve",
                  "deny"
                ]
              },
              "rateLimit": {
                "type": "string",
                "pattern": "^\\s*\\d+\\s*\\/\\s*(\\d+(\\.\\d+)?\\s*)?(ms|s|m|h|d|w|sec|second|min|minute|hr|hour|day|week)\\s*$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "tokens": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*[kKmM]?\\s*$"
            }
          ],
          "description": "A count: 12, 40k, 1.5m (million)."
        },
        "time": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*(\\d+(\\.\\d+)?\\s*(ms|s|m|h|d|w|y)\\s*)+$|^\\s*\\d+\\s*$"
            }
          ],
          "description": "A duration: 30s, 10m, 3d, 1h30m, or a number of milliseconds."
        },
        "modelCalls": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*[kKmM]?\\s*$"
            }
          ],
          "description": "A count: 12, 40k, 1.5m (million)."
        },
        "money": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "modelRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "taint": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "outboundWhenTainted": {
          "type": "string",
          "enum": [
            "allow",
            "preview",
            "approve",
            "deny"
          ]
        }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "properties": {
        "by": {
          "description": "Roles that may decide effect approvals.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "MemWise policy layer",
  "description": "domain/policy.yaml, workflows/<id>/policy.yaml, or the policy block of a step."
}
